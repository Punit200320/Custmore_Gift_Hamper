# ===================================================================
# Surreal Treasures Backend - Environment Variables Example
# Copy this file to .env (or configure your shell / IDE environment)
# NEVER commit real production credentials or API keys.
# ===================================================================

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/surreal_treasures
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# Hibernate / JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# CORS Configuration (comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# OpenRouter AI Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
